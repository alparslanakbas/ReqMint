<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ReqMint.App.ViewModels"
        xmlns:services="using:ReqMint.App.Services"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        x:Class="ReqMint.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        mc:Ignorable="d"
        d:DesignWidth="1440"
        d:DesignHeight="900"
        Title="ReqMint — API work, without the weight."
        Width="1440"
        Height="900"
        MinWidth="1080"
        MinHeight="680"
        WindowStartupLocation="CenterScreen">

    <Grid RowDefinitions="58,*,30">
        <!-- Top bar -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="16,0" ColumnDefinitions="Auto,18,220,*,360,18,190">
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                    <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource AccentBrush}">
                        <TextBlock Text="R➜"
                                   Foreground="{DynamicResource AppBackgroundBrush}"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="ReqMint" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>

                <Button Grid.Column="2"
                        HorizontalContentAlignment="Stretch"
                        Command="{Binding OpenWorkspaceCommand}"
                        ToolTip.Tip="Open a local ReqMint workspace">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding WorkspaceName}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Text="⌄" Classes="secondary" />
                    </Grid>
                </Button>

                <TextBox Grid.Column="4"
                         Height="34"
                         VerticalAlignment="Center"
                         PlaceholderText="{DynamicResource TextSearch}" />

                <ComboBox Grid.Column="6"
                          ItemsSource="{Binding EnvironmentNames}"
                          SelectedItem="{Binding EnvironmentName}"
                          HorizontalContentAlignment="Stretch"
                          ToolTip.Tip="Active environment" />
            </Grid>
        </Border>

        <!-- Workspace -->
        <Grid Grid.Row="1" ColumnDefinitions="64,264,*">
            <Border Grid.Column="0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                <Grid RowDefinitions="*,Auto" Margin="0,12">
                    <StackPanel Grid.Row="0" Spacing="8" HorizontalAlignment="Center">
                        <Button Classes="rail selected" ToolTip.Tip="Requests" Content="➤" Command="{Binding ShowCollectionsCommand}" />
                        <Button Classes="rail" ToolTip.Tip="Collections" Content="▣" Command="{Binding ShowCollectionsCommand}" />
                        <Button Classes="rail" ToolTip.Tip="History" Content="◷" Command="{Binding ShowHistoryCommand}" />
                        <Button Classes="rail" ToolTip.Tip="Environments" Content="◇" />
                        <Button Classes="rail" ToolTip.Tip="Runner" Content="▶" />
                        <Button Classes="rail" ToolTip.Tip="Git" Content="⑂" Command="{Binding ShowGitCommand}" />
                    </StackPanel>
                    <Button Grid.Row="1" Classes="rail" ToolTip.Tip="Settings" Content="⚙" />
                </Grid>
            </Border>

            <!-- Collection tree -->
            <Border Grid.Column="1"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid RowDefinitions="Auto,Auto,*,Auto" IsVisible="{Binding IsCollectionsVisible}">
                    <Grid Grid.Row="0" Margin="16,16,16,10" ColumnDefinitions="*,Auto,6,Auto">
                        <TextBlock Text="{DynamicResource TextWorkspace}" FontSize="17" FontWeight="SemiBold" />
                        <Button Grid.Column="1"
                                Content="▣＋"
                                Width="30"
                                Height="30"
                                Padding="0"
                                Command="{Binding CreateWorkspaceCommand}"
                                ToolTip.Tip="Create a workspace in a local folder" />
                        <Button Grid.Column="3"
                                Content="＋"
                                Width="30"
                                Height="30"
                                Padding="0"
                                Command="{Binding NewRequestCommand}"
                                ToolTip.Tip="Create a new request" />
                    </Grid>

                    <TextBox Grid.Row="1" Margin="12,0,12,12" PlaceholderText="{DynamicResource TextFilterRequests}" />

                    <ScrollViewer Grid.Row="2">
                        <ItemsControl Margin="8,0" ItemsSource="{Binding Collections}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:CollectionItemViewModel">
                                    <StackPanel Spacing="3" Margin="0,0,0,8">
                                        <Button Padding="10,7"
                                                BorderThickness="0"
                                                HorizontalContentAlignment="Stretch"
                                                Command="{Binding SelectCommand}">
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                <TextBlock Text="⌄" Classes="secondary" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Name}"
                                                           Margin="8,0"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="2" Text="{Binding RequestCount}" Classes="secondary" />
                                            </Grid>
                                        </Button>
                                        <ItemsControl ItemsSource="{Binding Requests}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:SavedRequestItemViewModel">
                                                    <Button Margin="14,0,0,0"
                                                            HorizontalContentAlignment="Stretch"
                                                            BorderThickness="0"
                                                            Command="{Binding OpenCommand}">
                                                        <Grid ColumnDefinitions="48,*">
                                                            <TextBlock Text="{Binding Method}"
                                                                       Foreground="{DynamicResource MethodGetBrush}"
                                                                       FontSize="11"
                                                                       FontWeight="Bold" />
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding Name}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Border Grid.Row="3" Margin="12" Padding="10" CornerRadius="6" Background="{DynamicResource SurfaceRaisedBrush}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding WorkspaceName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding WorkspaceLocation}"
                                       Classes="secondary"
                                       FontSize="11"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip.Tip="{Binding WorkspaceLocation}" />
                            <Button Content="{DynamicResource CollectionRunAction}"
                                    Margin="0,6,0,0"
                                    IsVisible="{Binding IsCollectionRunAvailable}"
                                    IsEnabled="{Binding !IsCollectionRunnerBusy}"
                                    Command="{Binding OpenCollectionRunnerCommand}" />
                        </StackPanel>
                    </Border>
                    </Grid>

                    <Grid RowDefinitions="Auto,Auto,*,Auto" IsVisible="{Binding IsHistoryVisible}">
                    <Grid Grid.Row="0" Margin="16,16,16,10" ColumnDefinitions="*,Auto,6,Auto">
                        <StackPanel Spacing="3">
                            <TextBlock Text="{DynamicResource TextHistory}" FontSize="17" FontWeight="SemiBold" />
                            <TextBlock Text="{DynamicResource TextHistorySubtitle}" Classes="secondary" FontSize="11" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="⌫"
                                Width="30"
                                Height="30"
                                Padding="0"
                                Command="{Binding ClearHistoryCommand}"
                                ToolTip.Tip="{DynamicResource TextClearHistory}" />
                        <Button Grid.Column="3"
                                Content="↻"
                                Width="30"
                                Height="30"
                                Padding="0"
                                Command="{Binding ShowHistoryCommand}"
                                ToolTip.Tip="{DynamicResource TextRefreshHistory}" />
                    </Grid>

                    <TextBox Grid.Row="1"
                             Margin="12,0,12,12"
                             Text="{Binding HistorySearchText}"
                             PlaceholderText="{DynamicResource TextSearchHistory}" />

                    <Grid Grid.Row="2">
                        <ListBox Margin="8,0"
                                 ItemsSource="{Binding History}"
                                 Background="Transparent"
                                 BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:RequestHistoryItemViewModel">
                                    <Button Padding="10,8"
                                            Margin="0,0,0,5"
                                            HorizontalContentAlignment="Stretch"
                                            BorderThickness="0"
                                            Command="{Binding OpenCommand}">
                                        <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="48,*,Auto">
                                            <TextBlock Text="{Binding Method}"
                                                       Foreground="{DynamicResource MethodGetBrush}"
                                                       FontSize="11"
                                                       FontWeight="Bold" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Name}"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="2" Text="{Binding Status}" Classes="secondary" FontSize="11" />
                                            <TextBlock Grid.Row="1"
                                                       Grid.ColumnSpan="3"
                                                       Text="{Binding Url}"
                                                       Classes="secondary"
                                                       FontSize="11"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Row="2"
                                                       Grid.ColumnSpan="3"
                                                       Text="{Binding SentAt}"
                                                       Classes="secondary"
                                                       FontSize="10" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Margin="18"
                                   Text="{DynamicResource TextNoHistoryResults}"
                                   IsVisible="{Binding IsHistoryEmpty}"
                                   Classes="secondary"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <Border Grid.Row="3" Margin="12" Padding="10" CornerRadius="6" Background="{DynamicResource SurfaceRaisedBrush}">
                            <TextBlock Text="{DynamicResource TextHistoryPrivacy}"
                                       Classes="secondary"
                                       FontSize="11"
                                       TextWrapping="Wrap" />
                    </Border>
                    </Grid>

                    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" IsVisible="{Binding IsGitVisible}">
                        <Grid Grid.Row="0" Margin="16,16,16,10" ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="3">
                                <TextBlock Text="{DynamicResource TextGit}" FontSize="17" FontWeight="SemiBold" />
                                <TextBlock Text="{DynamicResource TextGitSubtitle}" Classes="secondary" FontSize="11" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="↻"
                                    Width="30"
                                    Height="30"
                                    Padding="0"
                                    Command="{Binding ShowGitCommand}"
                                    ToolTip.Tip="{DynamicResource TextRefreshGit}" />
                        </Grid>

                        <Border Grid.Row="1" Margin="12,0,12,8" Padding="10" CornerRadius="6" Background="{DynamicResource SurfaceRaisedBrush}">
                            <Grid ColumnDefinitions="Auto,10,*">
                                <TextBlock Text="⑂" Foreground="{DynamicResource AccentBrush}" />
                                <TextBlock Grid.Column="2"
                                           Text="{Binding GitBranch}"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </Border>

                        <TextBlock Grid.Row="2"
                                   Margin="16,0,16,10"
                                   Text="{Binding GitRepositoryRoot}"
                                   Classes="secondary"
                                   FontSize="10"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip.Tip="{Binding GitRepositoryRoot}" />

                        <Grid Grid.Row="3">
                            <ListBox Margin="8,0"
                                     ItemsSource="{Binding GitChanges}"
                                     Background="Transparent"
                                     BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:GitChangeItemViewModel">
                                        <Button Margin="0,0,0,3"
                                                Padding="8,6"
                                                BorderThickness="0"
                                                HorizontalContentAlignment="Stretch"
                                                Command="{Binding OpenCommand}">
                                            <Grid ColumnDefinitions="28,*,Auto,4,Auto">
                                                <TextBlock Text="{Binding Status}"
                                                           Classes="gitStatus"
                                                           Classes.warning="{Binding IsConflict}"
                                                           FontFamily="Cascadia Mono, Consolas"
                                                           FontWeight="Bold" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Path}"
                                                           FontFamily="Cascadia Mono, Consolas"
                                                           FontSize="11"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="2"
                                                           Text="S"
                                                           IsVisible="{Binding HasStagedChanges}"
                                                           Classes="secondary"
                                                           FontSize="10"
                                                           FontWeight="Bold"
                                                           ToolTip.Tip="{DynamicResource GitDiffStaged}" />
                                                <TextBlock Grid.Column="4"
                                                           Text="W"
                                                           IsVisible="{Binding HasWorkingTreeChanges}"
                                                           Classes="secondary"
                                                           FontSize="10"
                                                           FontWeight="Bold"
                                                           ToolTip.Tip="{DynamicResource GitDiffWorkingTree}" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Margin="18"
                                       Text="{Binding GitSummary}"
                                       IsVisible="{Binding IsGitChangeListEmpty}"
                                       Classes="secondary"
                                       TextWrapping="Wrap"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <Border Grid.Row="4" Margin="12" Padding="10" CornerRadius="6" Background="{DynamicResource SurfaceRaisedBrush}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{Binding GitSummary}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding GitSecuritySummary}"
                                           IsVisible="{Binding IsGitSecuritySummaryVisible}"
                                           Classes="secondary"
                                           Classes.warning="{Binding HasGitSecurityWarning}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{DynamicResource TextGitReadOnly}"
                                           Classes="secondary"
                                           FontSize="11"
                                           TextWrapping="Wrap" />
                                <Button Content="{DynamicResource GitCommitReviewAction}"
                                        Margin="0,6,0,0"
                                        IsVisible="{Binding IsGitCommitReviewAvailable}"
                                        IsEnabled="{Binding !IsGitCommitBusy}"
                                        Command="{Binding ReviewGitCommitCommand}" />
                                <Button Content="{DynamicResource GitRemoteReviewAction}"
                                        Margin="0,4,0,0"
                                        IsVisible="{Binding IsGitRemoteReviewAvailable}"
                                        IsEnabled="{Binding !IsGitRemoteBusy}"
                                        Command="{Binding ReviewGitRemoteCommand}" />
                                <Button Content="{DynamicResource GitFastForwardReviewAction}"
                                        Margin="0,4,0,0"
                                        IsVisible="{Binding IsGitFastForwardReviewAvailable}"
                                        IsEnabled="{Binding !IsGitFastForwardBusy}"
                                        Command="{Binding ReviewGitFastForwardCommand}" />
                                <Button Content="{DynamicResource GitPushReviewAction}"
                                        Margin="0,4,0,0"
                                        IsVisible="{Binding IsGitPushReviewAvailable}"
                                        IsEnabled="{Binding !IsGitPushBusy}"
                                        Command="{Binding ReviewGitPushCommand}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- Request workspace and Git diff preview -->
            <Grid Grid.Column="2">
            <Grid RowDefinitions="44,72,*,38" IsVisible="{Binding IsRequestWorkspaceVisible}">
                <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal" Margin="14,0" VerticalAlignment="Center" Spacing="10">
                        <TextBlock Text="{Binding SelectedMethod}" Foreground="{DynamicResource MethodGetBrush}" FontSize="11" FontWeight="Bold" />
                        <TextBox Text="{Binding RequestName}"
                                 Width="240"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 FontWeight="SemiBold"
                                 PlaceholderText="{DynamicResource TextRequestName}" />
                        <TextBlock Text="×" Classes="secondary" />
                    </StackPanel>
                </Border>

                <Grid Grid.Row="1" Margin="16,14" ColumnDefinitions="108,12,*,12,86,8,104">
                    <ComboBox Grid.Column="0"
                              ItemsSource="{Binding Methods}"
                              SelectedItem="{Binding SelectedMethod}"
                              HorizontalContentAlignment="Stretch" />
                    <TextBox Grid.Column="2" Text="{Binding Url}" PlaceholderText="Enter an HTTP or HTTPS URL" />
                    <Button Grid.Column="4"
                            Content="{DynamicResource TextSave}"
                            Command="{Binding SaveRequestCommand}" />
                    <Button Grid.Column="6"
                            Classes="primary"
                            Content="{DynamicResource TextSend}"
                            Command="{Binding SendCommand}" />
                </Grid>

                <Grid Grid.Row="2" RowDefinitions="2*,42,3*">
                    <TabControl Grid.Row="0" Background="{DynamicResource AppBackgroundBrush}">
                        <TabItem Header="{DynamicResource TextParams}">
                            <Grid RowDefinitions="*,Auto" Margin="18,12">
                                <ScrollViewer Grid.Row="0">
                                    <ItemsControl ItemsSource="{Binding QueryParameters}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:RequestFieldViewModel">
                                                <Grid ColumnDefinitions="32,220,12,*" Margin="0,0,0,8">
                                                    <CheckBox IsChecked="{Binding IsEnabled}" VerticalAlignment="Center" />
                                                    <TextBox Grid.Column="1" Text="{Binding Name}" PlaceholderText="Parameter name" />
                                                    <TextBox Grid.Column="3" Text="{Binding Value}" PlaceholderText="Value" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <Button Grid.Row="1"
                                        HorizontalAlignment="Left"
                                        Content="{DynamicResource TextAddParameter}"
                                        Command="{Binding AddQueryParameterCommand}" />
                            </Grid>
                        </TabItem>

                        <TabItem Header="{DynamicResource TextHeaders}">
                            <Grid RowDefinitions="*,Auto" Margin="18,12">
                                <ScrollViewer Grid.Row="0">
                                    <ItemsControl ItemsSource="{Binding Headers}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:RequestFieldViewModel">
                                                <Grid ColumnDefinitions="32,220,12,*" Margin="0,0,0,8">
                                                    <CheckBox IsChecked="{Binding IsEnabled}" VerticalAlignment="Center" />
                                                    <TextBox Grid.Column="1" Text="{Binding Name}" PlaceholderText="Header name" />
                                                    <TextBox Grid.Column="3" Text="{Binding Value}" PlaceholderText="Value" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <Button Grid.Row="1"
                                        HorizontalAlignment="Left"
                                        Content="{DynamicResource TextAddHeader}"
                                        Command="{Binding AddHeaderCommand}" />
                            </Grid>
                        </TabItem>

                        <TabItem Header="{DynamicResource TextBody}">
                            <Grid RowDefinitions="Auto,12,*" Margin="18,12">
                                <Grid Grid.Row="0" ColumnDefinitions="180,16,*">
                                    <ComboBox ItemsSource="{Binding BodyTypes}"
                                              SelectedItem="{Binding SelectedBodyType}" />
                                    <TextBlock Grid.Column="2"
                                               Text="Body content is sent with the selected media type."
                                               Classes="secondary"
                                               VerticalAlignment="Center" />
                                </Grid>
                                <TextBox Grid.Row="2"
                                         Text="{Binding RequestBody}"
                                         IsEnabled="{Binding IsBodyEnabled}"
                                         AcceptsReturn="True"
                                         TextWrapping="NoWrap"
                                         VerticalContentAlignment="Top"
                                         FontFamily="Cascadia Mono, Consolas"
                                         PlaceholderText="Select a body type, then enter request content..." />
                            </Grid>
                        </TabItem>

                        <TabItem Header="{DynamicResource TextEnvironment}">
                            <Grid RowDefinitions="Auto,12,*,12,Auto" Margin="18,12">
                                <Grid Grid.Row="0" ColumnDefinitions="*,10,Auto">
                                    <TextBox Text="{Binding EnvironmentDraftName}"
                                             PlaceholderText="{DynamicResource TextEnvironmentName}" />
                                    <Button Grid.Column="2"
                                            Content="{DynamicResource TextNewEnvironment}"
                                            Command="{Binding NewEnvironmentCommand}" />
                                </Grid>

                                <ScrollViewer Grid.Row="2">
                                    <ItemsControl ItemsSource="{Binding EnvironmentVariables}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:EnvironmentVariableViewModel">
                                                <Grid ColumnDefinitions="220,12,*,12,90" Margin="0,0,0,8">
                                                    <TextBox Text="{Binding Name}" PlaceholderText="Variable name" />
                                                    <TextBox Grid.Column="2"
                                                             Text="{Binding Value}"
                                                             IsVisible="{Binding !IsSecret}"
                                                             PlaceholderText="Value" />
                                                    <TextBox Grid.Column="2"
                                                             Text="{Binding Value}"
                                                             IsVisible="{Binding IsSecret}"
                                                             PasswordChar="●"
                                                             PlaceholderText="Secret value" />
                                                    <CheckBox Grid.Column="4"
                                                              IsChecked="{Binding IsSecret}"
                                                              Content="Secret"
                                                              VerticalAlignment="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <Grid Grid.Row="4" ColumnDefinitions="Auto,10,Auto,16,*">
                                    <Button Content="{DynamicResource TextAddVariable}"
                                            Command="{Binding AddEnvironmentVariableCommand}" />
                                    <Button Grid.Column="2"
                                            Classes="primary"
                                            Content="{DynamicResource TextSaveEnvironment}"
                                            Command="{Binding SaveEnvironmentCommand}" />
                                    <TextBlock Grid.Column="4"
                                               Text="Secret inputs are stored in the OS vault and cleared after saving."
                                               Classes="secondary"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap" />
                                </Grid>
                            </Grid>
                        </TabItem>

                        <TabItem Header="{DynamicResource TextSettings}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="18" Spacing="10" MaxWidth="620" HorizontalAlignment="Left">
                                <TextBlock Text="{DynamicResource TextRequestTimeout}" FontWeight="SemiBold" />
                                <Grid ColumnDefinitions="160,10,Auto">
                                    <NumericUpDown Grid.Column="0"
                                                   Minimum="1"
                                                   Maximum="600"
                                                   Increment="1"
                                                   Value="{Binding TimeoutSeconds}" />
                                    <TextBlock Grid.Column="2" Text="{DynamicResource TextSeconds}" Classes="secondary" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock Text="{DynamicResource TextAssertions}"
                                           FontWeight="SemiBold"
                                           Margin="0,10,0,0" />
                                <TextBlock Text="{DynamicResource TextAssertionsHelp}"
                                           Classes="secondary"
                                           TextWrapping="Wrap" />
                                <Grid ColumnDefinitions="190,10,160,*">
                                    <CheckBox Content="{DynamicResource TextAssertStatusCode}"
                                              IsChecked="{Binding IsStatusAssertionEnabled}"
                                              VerticalAlignment="Center" />
                                    <NumericUpDown Grid.Column="2"
                                                   Minimum="100"
                                                   Maximum="599"
                                                   Increment="1"
                                                   Value="{Binding AssertionExpectedStatusCode}"
                                                   IsEnabled="{Binding IsStatusAssertionEnabled}" />
                                </Grid>
                                <Grid ColumnDefinitions="190,10,160,*">
                                    <CheckBox Content="{DynamicResource TextAssertDuration}"
                                              IsChecked="{Binding IsDurationAssertionEnabled}"
                                              VerticalAlignment="Center" />
                                    <NumericUpDown Grid.Column="2"
                                                   Minimum="1"
                                                   Maximum="600000"
                                                   Increment="50"
                                                   Value="{Binding AssertionMaximumDurationMilliseconds}"
                                                   IsEnabled="{Binding IsDurationAssertionEnabled}" />
                                    <TextBlock Grid.Column="3"
                                               Margin="8,0,0,0"
                                               Text="ms"
                                               Classes="secondary"
                                               VerticalAlignment="Center" />
                                </Grid>
                                <Grid ColumnDefinitions="190,10,*">
                                    <CheckBox Content="{DynamicResource TextAssertJsonField}"
                                              IsChecked="{Binding IsJsonFieldAssertionEnabled}"
                                              VerticalAlignment="Center" />
                                    <TextBox Grid.Column="2"
                                             Text="{Binding AssertionJsonPointer}"
                                             IsEnabled="{Binding IsJsonFieldAssertionEnabled}"
                                             PlaceholderText="/data/id" />
                                </Grid>
                                <TextBlock Text="{DynamicResource TextResponsePreviewLimit}" FontWeight="SemiBold" Margin="0,10,0,0" />
                                <Grid ColumnDefinitions="160,10,*">
                                    <NumericUpDown Grid.Column="0"
                                                   Minimum="1"
                                                   Maximum="20"
                                                   Increment="1"
                                                   Value="{Binding ResponsePreviewLimitMegabytes}" />
                                    <TextBlock Grid.Column="2"
                                               Text="{DynamicResource TextResponsePreviewLimitHelp}"
                                               Classes="secondary"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap" />
                                </Grid>
                                <TextBlock Text="{DynamicResource TextLanguage}" FontWeight="SemiBold" Margin="0,10,0,0" />
                                <ComboBox ItemsSource="{Binding Localization.Languages}"
                                          SelectedItem="{Binding Localization.SelectedLanguage}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="services:LanguageOption">
                                            <TextBlock Text="{Binding DisplayName}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Text="{DynamicResource TextHistoryRetention}" FontWeight="SemiBold" Margin="0,10,0,0" />
                                <Grid ColumnDefinitions="160,10,*">
                                    <NumericUpDown Grid.Column="0"
                                                   Minimum="25"
                                                   Maximum="2000"
                                                   Increment="25"
                                                   Value="{Binding HistoryRetentionLimit}" />
                                    <TextBlock Grid.Column="2"
                                               Text="{DynamicResource TextHistoryRetentionHelp}"
                                               Classes="secondary"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap" />
                                </Grid>
                                <TextBlock Text="{DynamicResource TextCollectionManagement}" FontWeight="SemiBold" Margin="0,10,0,0" />
                                <Grid ColumnDefinitions="*,10,Auto,10,Auto">
                                    <TextBox Text="{Binding CollectionDraftName}"
                                             PlaceholderText="{DynamicResource TextCollectionName}" />
                                    <Button Grid.Column="2"
                                            Content="{DynamicResource TextNewCollection}"
                                            Command="{Binding CreateCollectionCommand}" />
                                    <Button Grid.Column="4"
                                            Content="{DynamicResource TextRenameCollection}"
                                            Command="{Binding RenameCollectionCommand}" />
                                </Grid>
                                <TextBlock Text="The request and response preview are cancelled when this limit is reached."
                                           Classes="secondary"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>

                    <Border Grid.Row="1" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1">
                        <Grid Margin="16,0" ColumnDefinitions="Auto,18,Auto,*,Auto,18,Auto">
                            <TextBlock Text="Response" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding ResponseStatus}" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="4" Text="{Binding ResponseTime}" Classes="secondary" VerticalAlignment="Center" />
                            <Button Grid.Column="6" Content="Copy" Padding="10,4" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Padding="18" Background="{DynamicResource AppBackgroundBrush}">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <TextBlock Text="{Binding ResponseBody}"
                                       FontFamily="Cascadia Mono, Consolas"
                                       FontSize="13"
                                       TextWrapping="NoWrap" />
                        </ScrollViewer>
                    </Border>
                </Grid>

                <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                    <Grid Margin="14,0" ColumnDefinitions="Auto,18,Auto,*,Auto">
                        <TextBlock Text="{Binding GitBranch}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding GitSummary}" Classes="secondary" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentBrush}" />
                            <TextBlock Text="{Binding ResponseStatus}" Classes="secondary" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Grid RowDefinitions="56,*" IsVisible="{Binding IsCollectionRunnerVisible}">
                <Border Grid.Row="0"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,0,1">
                    <Grid Margin="18,0" ColumnDefinitions="Auto,12,*,Auto">
                        <TextBlock Text="▶"
                                   Foreground="{DynamicResource AccentBrush}"
                                   FontSize="16"
                                   VerticalAlignment="Center" />
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource CollectionRunTitle}"
                                       FontSize="16"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{Binding CollectionRunTitle}"
                                       Classes="secondary"
                                       FontSize="11" />
                        </StackPanel>
                        <Button Grid.Column="3"
                                Content="×"
                                Width="30"
                                Height="30"
                                Padding="0"
                                IsEnabled="{Binding IsCollectionRunnerInteractionEnabled}"
                                Command="{Binding CloseCollectionRunnerCommand}" />
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="24" RowDefinitions="Auto,12,Auto,16,*,16,Auto">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding CollectionRunSummary}"
                                       Foreground="{DynamicResource AccentBrush}"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding CollectionRunProgress}"
                                       Classes="secondary"
                                       FontSize="11" />
                        </StackPanel>
                        <CheckBox Grid.Column="1"
                                  Content="{DynamicResource CollectionRunStopOnFailure}"
                                  IsChecked="{Binding CollectionRunStopOnFailure}"
                                  IsEnabled="{Binding IsCollectionRunnerInteractionEnabled}"
                                  VerticalAlignment="Center" />
                    </Grid>

                    <Border Grid.Row="2"
                            Padding="12"
                            CornerRadius="8"
                            Background="{DynamicResource SurfaceRaisedBrush}">
                        <TextBlock Text="{DynamicResource CollectionRunSafetyNote}"
                                   Classes="secondary"
                                   FontSize="11"
                                   TextWrapping="Wrap" />
                    </Border>

                    <Border Grid.Row="4"
                            Padding="14"
                            CornerRadius="8"
                            Background="{DynamicResource SurfaceRaisedBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1">
                        <Grid RowDefinitions="Auto,10,*">
                            <TextBlock Text="{DynamicResource CollectionRunResults}"
                                       FontWeight="SemiBold" />
                            <ListBox Grid.Row="2"
                                     ItemsSource="{Binding CollectionRunResults}"
                                     Background="Transparent"
                                     BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:CollectionRunItemViewModel">
                                        <Grid Margin="0,0,0,9"
                                              RowDefinitions="Auto,Auto"
                                              ColumnDefinitions="*,110,120,90">
                                            <TextBlock Text="{Binding Name}"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Status}"
                                                       Foreground="{DynamicResource AccentBrush}" />
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding Detail}"
                                                       Classes="secondary" />
                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding Duration}"
                                                       Classes="secondary"
                                                       HorizontalAlignment="Right" />
                                            <TextBlock Grid.Row="1"
                                                       Grid.ColumnSpan="4"
                                                       Margin="0,3,0,0"
                                                       Text="{Binding Assertions}"
                                                       Classes="secondary"
                                                       FontSize="10"
                                                       TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="6"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Spacing="8">
                        <Button Content="{DynamicResource CollectionRunClose}"
                                IsEnabled="{Binding IsCollectionRunnerInteractionEnabled}"
                                Command="{Binding CloseCollectionRunnerCommand}" />
                        <Button Content="{DynamicResource CollectionRunExportJson}"
                                IsVisible="{Binding HasCollectionRunResult}"
                                IsEnabled="{Binding IsCollectionRunnerInteractionEnabled}"
                                Command="{Binding ExportCollectionRunJsonCommand}" />
                        <Button Content="{DynamicResource CollectionRunExportJUnit}"
                                IsVisible="{Binding HasCollectionRunResult}"
                                IsEnabled="{Binding IsCollectionRunnerInteractionEnabled}"
                                Command="{Binding ExportCollectionRunJUnitCommand}" />
                        <Button Content="{DynamicResource CollectionRunCancel}"
                                IsVisible="{Binding IsCollectionRunnerBusy}"
                                Command="{Binding CancelCollectionRunCommand}" />
                        <Button Content="{DynamicResource CollectionRunStart}"
                                IsVisible="{Binding !IsCollectionRunnerBusy}"
                                IsEnabled="{Binding IsCollectionRunnerInteractionEnabled}"
                                Command="{Binding StartCollectionRunCommand}" />
                    </StackPanel>
                </Grid>
            </Grid>

            <Grid RowDefinitions="44,56,*" IsVisible="{Binding IsGitDiffVisible}">
                <Border Grid.Row="0"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,0,1">
                    <Grid Margin="16,0" ColumnDefinitions="Auto,12,*,Auto">
                        <TextBlock Text="⑂"
                                   Foreground="{DynamicResource AccentBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2"
                                   Text="{Binding GitDiffPath}"
                                   FontFamily="Cascadia Mono, Consolas"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="3"
                                Content="×"
                                Width="30"
                                Height="30"
                                Padding="0"
                                Command="{Binding CloseGitDiffCommand}"
                                ToolTip.Tip="{DynamicResource GitDiffClose}" />
                    </Grid>
                </Border>

                <Border Grid.Row="1"
                        Background="{DynamicResource SurfaceRaisedBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,0,1">
                    <Grid Margin="16,0" ColumnDefinitions="Auto,8,Auto,18,*,12,Auto">
                        <Button Content="{DynamicResource GitDiffWorkingTree}"
                                IsVisible="{Binding HasGitWorkingTreeDiff}"
                                Padding="10,5"
                                Command="{Binding ShowWorkingTreeDiffCommand}" />
                        <Button Grid.Column="2"
                                Content="{DynamicResource GitDiffStaged}"
                                IsVisible="{Binding HasGitStagedDiff}"
                                Padding="10,5"
                                Command="{Binding ShowStagedDiffCommand}" />
                        <TextBlock Grid.Column="4"
                                   Text="{Binding GitDiffSummary}"
                                   Classes="secondary"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="6"
                                Content="{DynamicResource GitStageReviewAction}"
                                IsVisible="{Binding IsGitStageAvailable}"
                                IsEnabled="{Binding !IsGitStageBusy}"
                                Padding="12,6"
                                Command="{Binding ReviewGitStageCommand}" />
                    </Grid>
                </Border>

                <Grid Grid.Row="2" Background="{DynamicResource AppBackgroundBrush}">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl Margin="18,14" ItemsSource="{Binding GitDiffLines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:GitDiffLineViewModel">
                                    <TextBlock Text="{Binding Text}"
                                               FontFamily="Cascadia Mono, Consolas"
                                               FontSize="12"
                                               Classes.diffAdded="{Binding IsAdded}"
                                               Classes.diffRemoved="{Binding IsRemoved}"
                                               Classes.diffHunk="{Binding IsHunk}"
                                               Classes.diffHeader="{Binding IsHeader}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <StackPanel Margin="28"
                                MaxWidth="560"
                                Spacing="10"
                                IsVisible="{Binding IsGitDiffLineListEmpty}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <TextBlock Text="⚠"
                                   IsVisible="{Binding IsGitDiffSecurityBlocked}"
                                   Foreground="{DynamicResource WarningBrush}"
                                   FontSize="28"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="!"
                                   IsVisible="{Binding IsGitConflictGuidanceVisible}"
                                   Foreground="{DynamicResource WarningBrush}"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{DynamicResource GitConflictDetected}"
                                   IsVisible="{Binding IsGitConflictGuidanceVisible}"
                                   Foreground="{DynamicResource WarningBrush}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding GitDiffMessage}"
                                   Classes="secondary"
                                   Classes.warning="{Binding IsGitDiffSecurityBlocked}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                        <Border IsVisible="{Binding IsGitConflictGuidanceVisible}"
                                Margin="0,8,0,0"
                                Padding="16"
                                CornerRadius="8"
                                Background="{DynamicResource SurfaceRaisedBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1">
                            <StackPanel Spacing="9">
                                <TextBlock Text="{DynamicResource GitConflictStep1}" TextWrapping="Wrap" />
                                <TextBlock Text="{DynamicResource GitConflictStep2}" TextWrapping="Wrap" />
                                <TextBlock Text="{DynamicResource GitConflictStep3}" TextWrapping="Wrap" />
                                <TextBlock Text="{DynamicResource GitConflictStep4}" TextWrapping="Wrap" />
                                <TextBlock Text="{DynamicResource GitConflictSafetyNote}"
                                           Classes="secondary"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Margin="0,5,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <Border IsVisible="{Binding IsGitStageReviewVisible}"
                            ZIndex="10"
                            Width="460"
                            Padding="20"
                            CornerRadius="10"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource AccentBrush}"
                            BorderThickness="1">
                        <StackPanel Spacing="12">
                            <TextBlock Text="{DynamicResource GitStageReviewTitle}"
                                       FontSize="18"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{Binding GitDiffPath}"
                                       FontFamily="Cascadia Mono, Consolas"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{DynamicResource GitStageReviewMessage}"
                                       Classes="secondary"
                                       TextWrapping="Wrap" />
                            <Border Padding="10"
                                    CornerRadius="6"
                                    Background="{DynamicResource SurfaceRaisedBrush}">
                                <TextBlock Text="{DynamicResource GitStageSafetyNote}"
                                           FontSize="11"
                                           TextWrapping="Wrap" />
                            </Border>
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        Spacing="8">
                                <Button Content="{DynamicResource GitStageCancel}"
                                        IsEnabled="{Binding !IsGitStageBusy}"
                                        Command="{Binding CancelGitStageReviewCommand}" />
                                <Button Content="{DynamicResource GitStageConfirm}"
                                        IsEnabled="{Binding !IsGitStageBusy}"
                                        Command="{Binding ConfirmGitStageCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <Grid RowDefinitions="56,*" IsVisible="{Binding IsGitCommitVisible}">
                <Border Grid.Row="0"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,0,1">
                    <Grid Margin="18,0" ColumnDefinitions="*,Auto">
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Spacing="10">
                            <TextBlock Text="⑂"
                                       Foreground="{DynamicResource AccentBrush}"
                                       FontSize="18" />
                            <TextBlock Text="{DynamicResource GitCommitReviewTitle}"
                                       FontSize="17"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="×"
                                Width="30"
                                Height="30"
                                Padding="0"
                                IsEnabled="{Binding !IsGitCommitBusy}"
                                Command="{Binding CancelGitCommitCommand}" />
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="28"
                                MaxWidth="680"
                                HorizontalAlignment="Center"
                                Spacing="14">
                        <TextBlock Text="{Binding GitCommitSummary}"
                                   Foreground="{DynamicResource AccentBrush}"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                        <Border Padding="14"
                                CornerRadius="8"
                                Background="{DynamicResource SurfaceRaisedBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{DynamicResource GitCommitFilesTitle}"
                                           FontWeight="SemiBold" />
                                <ItemsControl ItemsSource="{Binding GitCommitFiles}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}"
                                                       FontFamily="Cascadia Mono, Consolas"
                                                       FontSize="11"
                                                       TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{DynamicResource GitCommitMessageLabel}"
                                   FontWeight="SemiBold" />
                        <TextBox Text="{Binding GitCommitMessage}"
                                 MaxLength="72"
                                 IsEnabled="{Binding !IsGitCommitBusy}"
                                 PlaceholderText="{DynamicResource GitCommitMessagePlaceholder}" />
                        <TextBlock Text="{Binding GitCommitValidationMessage}"
                                   IsVisible="{Binding IsGitCommitValidationVisible}"
                                   Classes="warning"
                                   FontSize="11"
                                   TextWrapping="Wrap" />
                        <Border Padding="12"
                                CornerRadius="7"
                                Background="{DynamicResource SurfaceRaisedBrush}">
                            <TextBlock Text="{DynamicResource GitCommitSafetyNote}"
                                       Classes="secondary"
                                       FontSize="11"
                                       TextWrapping="Wrap" />
                        </Border>
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Spacing="8">
                            <Button Content="{DynamicResource GitCommitCancel}"
                                    IsEnabled="{Binding !IsGitCommitBusy}"
                                    Command="{Binding CancelGitCommitCommand}" />
                            <Button Content="{DynamicResource GitCommitConfirm}"
                                    IsEnabled="{Binding !IsGitCommitBusy}"
                                    Command="{Binding ConfirmGitCommitCommand}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Grid RowDefinitions="56,*" IsVisible="{Binding IsGitRemoteVisible}">
                <Border Grid.Row="0"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,0,1">
                    <Grid Margin="18,0" ColumnDefinitions="*,Auto">
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Spacing="10">
                            <TextBlock Text="⇄"
                                       Foreground="{DynamicResource AccentBrush}"
                                       FontSize="18" />
                            <TextBlock Text="{DynamicResource GitRemoteReviewTitle}"
                                       FontSize="17"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="×"
                                Width="30"
                                Height="30"
                                Padding="0"
                                IsEnabled="{Binding !IsGitRemoteBusy}"
                                Command="{Binding CancelGitRemoteCommand}" />
                    </Grid>
                </Border>

                <StackPanel Grid.Row="1"
                            Margin="28"
                            MaxWidth="640"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="14">
                    <Border Padding="16"
                            CornerRadius="9"
                            Background="{DynamicResource SurfaceRaisedBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1">
                        <Grid ColumnDefinitions="Auto,14,*" RowDefinitions="Auto,6,Auto">
                            <TextBlock Text="{DynamicResource GitRemoteNameLabel}"
                                       Classes="secondary" />
                            <TextBlock Grid.Column="2"
                                       Text="{Binding GitRemoteName}"
                                       FontFamily="Cascadia Mono, Consolas"
                                       FontWeight="SemiBold" />
                            <TextBlock Grid.Row="2"
                                       Text="{DynamicResource GitRemoteBranchLabel}"
                                       Classes="secondary" />
                            <TextBlock Grid.Row="2"
                                       Grid.Column="2"
                                       Text="{Binding GitRemoteBranch}"
                                       FontFamily="Cascadia Mono, Consolas"
                                       FontWeight="SemiBold" />
                        </Grid>
                    </Border>
                    <TextBlock Text="{Binding GitRemoteSummary}"
                               FontSize="15"
                               TextWrapping="Wrap" />
                    <Border Padding="14"
                            CornerRadius="8"
                            Background="{DynamicResource SurfaceRaisedBrush}">
                        <StackPanel Spacing="7">
                            <TextBlock Text="{DynamicResource GitRemoteSafetyTitle}"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{DynamicResource GitRemoteSafetyRefs}"
                                       Classes="secondary"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{DynamicResource GitRemoteSafetyLocal}"
                                       Classes="secondary"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{DynamicResource GitRemoteSafetyNetwork}"
                                       Classes="secondary"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Spacing="8">
                        <Button Content="{DynamicResource GitRemoteCancel}"
                                IsEnabled="{Binding !IsGitRemoteBusy}"
                                Command="{Binding CancelGitRemoteCommand}" />
                        <Button Content="{DynamicResource GitRemoteConfirmFetch}"
                                IsEnabled="{Binding !IsGitRemoteBusy}"
                                Command="{Binding ConfirmGitFetchCommand}" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <Grid RowDefinitions="56,*" IsVisible="{Binding IsGitFastForwardVisible}">
                <Border Grid.Row="0"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,0,1">
                    <Grid Margin="18,0" ColumnDefinitions="*,Auto">
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Spacing="10">
                            <TextBlock Text="⇣"
                                       Foreground="{DynamicResource AccentBrush}"
                                       FontSize="18" />
                            <TextBlock Text="{DynamicResource GitFastForwardReviewTitle}"
                                       FontSize="17"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="×"
                                Width="30"
                                Height="30"
                                Padding="0"
                                IsEnabled="{Binding !IsGitFastForwardBusy}"
                                Command="{Binding CancelGitFastForwardCommand}" />
                    </Grid>
                </Border>

                <Grid Grid.Row="1"
                      Margin="24"
                      RowDefinitions="Auto,12,*,12,Auto">
                    <TextBlock Text="{Binding GitFastForwardSummary}"
                               Foreground="{DynamicResource AccentBrush}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                    <Grid Grid.Row="2" ColumnDefinitions="*,12,*">
                        <Border Padding="14"
                                CornerRadius="8"
                                Background="{DynamicResource SurfaceRaisedBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1">
                            <Grid RowDefinitions="Auto,8,*">
                                <TextBlock Text="{DynamicResource GitFastForwardCommitsTitle}"
                                           FontWeight="SemiBold" />
                                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding GitFastForwardCommits}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}"
                                                           Margin="0,0,0,6"
                                                           FontFamily="Cascadia Mono, Consolas"
                                                           FontSize="11"
                                                           TextWrapping="Wrap" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                        <Border Grid.Column="2"
                                Padding="14"
                                CornerRadius="8"
                                Background="{DynamicResource SurfaceRaisedBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1">
                            <Grid RowDefinitions="Auto,8,*">
                                <TextBlock Text="{DynamicResource GitFastForwardPathsTitle}"
                                           FontWeight="SemiBold" />
                                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding GitFastForwardPaths}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}"
                                                           Margin="0,0,0,5"
                                                           FontFamily="Cascadia Mono, Consolas"
                                                           FontSize="11"
                                                           TextWrapping="Wrap" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                    <Grid Grid.Row="4" ColumnDefinitions="*,Auto">
                        <TextBlock Text="{DynamicResource GitFastForwardSafetyNote}"
                                   Classes="secondary"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1"
                                    Margin="16,0,0,0"
                                    Orientation="Horizontal"
                                    Spacing="8">
                            <Button Content="{DynamicResource GitFastForwardCancel}"
                                    IsEnabled="{Binding !IsGitFastForwardBusy}"
                                    Command="{Binding CancelGitFastForwardCommand}" />
                            <Button Content="{DynamicResource GitFastForwardConfirm}"
                                    IsEnabled="{Binding !IsGitFastForwardBusy}"
                                    Command="{Binding ConfirmGitFastForwardCommand}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>

            <Grid RowDefinitions="56,*" IsVisible="{Binding IsGitPushVisible}">
                <Border Grid.Row="0"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,0,1">
                    <Grid Margin="18,0" ColumnDefinitions="*,Auto">
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Spacing="10">
                            <TextBlock Text="⇡"
                                       Foreground="{DynamicResource AccentBrush}"
                                       FontSize="18" />
                            <TextBlock Text="{DynamicResource GitPushReviewTitle}"
                                       FontSize="17"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="×"
                                Width="30"
                                Height="30"
                                Padding="0"
                                IsEnabled="{Binding !IsGitPushBusy}"
                                Command="{Binding CancelGitPushCommand}" />
                    </Grid>
                </Border>

                <Grid Grid.Row="1"
                      Margin="24"
                      RowDefinitions="Auto,12,*,12,Auto">
                    <TextBlock Text="{Binding GitPushSummary}"
                               Foreground="{DynamicResource AccentBrush}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                    <Grid Grid.Row="2" ColumnDefinitions="*,12,*">
                        <Border Padding="14"
                                CornerRadius="8"
                                Background="{DynamicResource SurfaceRaisedBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1">
                            <Grid RowDefinitions="Auto,8,*">
                                <TextBlock Text="{DynamicResource GitPushCommitsTitle}"
                                           FontWeight="SemiBold" />
                                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding GitPushCommits}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}"
                                                           Margin="0,0,0,6"
                                                           FontFamily="Cascadia Mono, Consolas"
                                                           FontSize="11"
                                                           TextWrapping="Wrap" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                        <Border Grid.Column="2"
                                Padding="14"
                                CornerRadius="8"
                                Background="{DynamicResource SurfaceRaisedBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1">
                            <Grid RowDefinitions="Auto,8,*">
                                <TextBlock Text="{DynamicResource GitPushPathsTitle}"
                                           FontWeight="SemiBold" />
                                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding GitPushPaths}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}"
                                                           Margin="0,0,0,5"
                                                           FontFamily="Cascadia Mono, Consolas"
                                                           FontSize="11"
                                                           TextWrapping="Wrap" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                    <Grid Grid.Row="4" ColumnDefinitions="*,Auto">
                        <TextBlock Text="{DynamicResource GitPushSafetyNote}"
                                   Classes="secondary"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1"
                                    Margin="16,0,0,0"
                                    Orientation="Horizontal"
                                    Spacing="8">
                            <Button Content="{DynamicResource GitPushCancel}"
                                    IsEnabled="{Binding !IsGitPushBusy}"
                                    Command="{Binding CancelGitPushCommand}" />
                            <Button Content="{DynamicResource GitPushConfirm}"
                                    IsEnabled="{Binding !IsGitPushBusy}"
                                    Command="{Binding ConfirmGitPushCommand}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
            </Grid>
        </Grid>

        <!-- Global status -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="14,0" ColumnDefinitions="Auto,16,Auto,*,Auto">
                <TextBlock Text="ReqMint preview" Classes="secondary" VerticalAlignment="Center" FontSize="11" />
                <TextBlock Grid.Column="2" Text="API work, without the weight." Classes="secondary" VerticalAlignment="Center" FontSize="11" />
                <TextBlock Grid.Column="4" Text="{Binding WorkspaceStatus}" Classes="secondary" VerticalAlignment="Center" FontSize="11" />
            </Grid>
        </Border>
    </Grid>
</Window>
