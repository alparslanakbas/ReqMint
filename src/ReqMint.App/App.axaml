<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ReqMint.App.App"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <ResourceDictionary>
            <Color x:Key="Graphite950">#08110F</Color>
            <Color x:Key="Graphite900">#0D1715</Color>
            <Color x:Key="Graphite850">#111D1B</Color>
            <Color x:Key="Graphite800">#162321</Color>
            <Color x:Key="Graphite700">#263734</Color>
            <Color x:Key="TextPrimary">#EEF7F4</Color>
            <Color x:Key="TextSecondary">#91A49F</Color>
            <Color x:Key="Mint500">#21D6A0</Color>
            <Color x:Key="Mint700">#0D6B53</Color>
            <Color x:Key="Blue500">#4B9BFF</Color>
            <Color x:Key="Warning500">#FFB454</Color>
            <Color x:Key="DiffAdded500">#4ADE80</Color>
            <Color x:Key="DiffRemoved500">#FB7185</Color>
            <Color x:Key="DiffHunk500">#60A5FA</Color>
            <Color x:Key="OverlayColor">#D908110F</Color>

            <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource Graphite950}" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource Graphite900}" />
            <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{StaticResource Graphite850}" />
            <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource Graphite800}" />
            <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource Graphite700}" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}" />
            <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Mint500}" />
            <SolidColorBrush x:Key="AccentMutedBrush" Color="{StaticResource Mint700}" />
            <SolidColorBrush x:Key="MethodGetBrush" Color="{StaticResource Blue500}" />
            <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource Warning500}" />
            <SolidColorBrush x:Key="DiffAddedBrush" Color="{StaticResource DiffAdded500}" />
            <SolidColorBrush x:Key="DiffRemovedBrush" Color="{StaticResource DiffRemoved500}" />
            <SolidColorBrush x:Key="DiffHunkBrush" Color="{StaticResource DiffHunk500}" />
            <SolidColorBrush x:Key="OverlayBrush" Color="{StaticResource OverlayColor}" />

            <StreamGeometry x:Key="RailRequestsIcon">M2,21 23,12 2,3 2,10 17,12 2,14Z</StreamGeometry>
            <StreamGeometry x:Key="RailCollectionsIcon">M10,4 12,6 21,6C22.1,6 23,6.9 23,8L23,18C23,19.1 22.1,20 21,20L3,20C1.9,20 1,19.1 1,18L1,6C1,4.9 1.9,4 3,4Z</StreamGeometry>
            <StreamGeometry x:Key="RailHistoryIcon">M12,2C6.48,2 2,6.48 2,12S6.48,22 12,22 22,17.52 22,12 17.52,2 12,2M13,7H11V13L16.2,16.2 17.3,14.6 13,12Z</StreamGeometry>
            <StreamGeometry x:Key="RailEnvironmentsIcon">M3,5V7H13V5H3M3,11V13H7V15H9V9H7V11H3M11,9V11H21V13H23V7H21V9H11M11,17V19H15V21H17V15H15V17H11M19,17V19H23V17H19Z</StreamGeometry>
            <StreamGeometry x:Key="RailRunnerIcon">M8,5V19L19,12Z</StreamGeometry>
            <StreamGeometry x:Key="RailGitIcon">M6,3A3,3 0 1 0 6,9A3,3 0 0 0 6,3M18,15A3,3 0 1 0 18,21A3,3 0 0 0 18,15M6,15A3,3 0 1 0 6,21A3,3 0 0 0 6,15M8,8V15.2A3,3 0 0 1 10,18H15V16H10.8A1,1 0 0 1 10,15V11.5C11,12.5 12.4,13 14,13H15V11H14A4,4 0 0 1 10,7H8Z</StreamGeometry>
            <StreamGeometry x:Key="RailSettingsIcon">M19.43,12.98C19.47,12.66 19.5,12.34 19.5,12S19.47,11.34 19.42,11.02L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.65 15.48,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.52,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.72,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.58,11.02C4.53,11.34 4.5,11.67 4.5,12S4.53,12.66 4.58,12.98L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.04 4.95,18.95L7.44,17.95C7.96,18.35 8.52,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.48,18.68 16.04,18.34 16.56,17.95L19.05,18.95C19.28,19.04 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.98M12,15.5A3.5,3.5 0 1 1 12,8A3.5,3.5 0 0 1 12,15.5Z</StreamGeometry>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme DensityStyle="Compact" />

        <Style Selector="Window">
            <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontFamily" Value="avares://Avalonia.Fonts.Inter/Assets#Inter, Segoe UI, Noto Sans Arabic, Arial" />
        </Style>

        <Style Selector="TextBlock.secondary">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>

        <Style Selector="TextBlock.technical">
            <Setter Property="FlowDirection" Value="LeftToRight" />
        </Style>

        <Style Selector="TextBox.technical">
            <Setter Property="FlowDirection" Value="LeftToRight" />
        </Style>

        <Style Selector="TextBlock.warning">
            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
        </Style>

        <Style Selector="TextBlock.gitStatus">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        </Style>

        <Style Selector="TextBlock.gitStatus.warning">
            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
        </Style>

        <Style Selector="TextBlock.diffAdded">
            <Setter Property="Foreground" Value="{DynamicResource DiffAddedBrush}" />
        </Style>

        <Style Selector="TextBlock.diffRemoved">
            <Setter Property="Foreground" Value="{DynamicResource DiffRemovedBrush}" />
        </Style>

        <Style Selector="TextBlock.diffHunk">
            <Setter Property="Foreground" Value="{DynamicResource DiffHunkBrush}" />
        </Style>

        <Style Selector="TextBlock.diffHeader">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12,7" />
        </Style>

        <Style Selector="Button:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
        </Style>

        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AppBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="Button.rail">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style Selector="Button.rail.selected">
            <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        </Style>

        <Style Selector="TextBox, ComboBox">
            <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>

        <Style Selector="ComboBoxItem">
            <Setter Property="Margin" Value="4,1" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <Style Selector="Border.requestTab">
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <Style Selector="Border.requestTab.selected">
            <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>

        <Style Selector="Button.requestTabBody">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="TextBlock.method">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>

        <Style Selector="TextBlock.method.get">
            <Setter Property="Foreground" Value="{DynamicResource MethodGetBrush}" />
        </Style>

        <Style Selector="TextBlock.method.post">
            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
        </Style>

        <Style Selector="TextBlock.method.put">
            <Setter Property="Foreground" Value="{DynamicResource DiffHunkBrush}" />
        </Style>

        <Style Selector="TextBlock.method.patch">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        </Style>

        <Style Selector="TextBlock.method.delete">
            <Setter Property="Foreground" Value="{DynamicResource DiffRemovedBrush}" />
        </Style>

        <!-- Response status colours reuse the theme's existing semantic palette so
             all themes stay correct without adding colours to every one of them.
             Colour only reinforces the status text, which always spells it out. -->
        <Style Selector="TextBlock.responseStatus">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>

        <Style Selector="TextBlock.responseStatus.success">
            <Setter Property="Foreground" Value="{DynamicResource DiffAddedBrush}" />
        </Style>

        <Style Selector="TextBlock.responseStatus.redirect">
            <Setter Property="Foreground" Value="{DynamicResource DiffHunkBrush}" />
        </Style>

        <Style Selector="TextBlock.responseStatus.clientError">
            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
        </Style>

        <Style Selector="TextBlock.responseStatus.failure">
            <Setter Property="Foreground" Value="{DynamicResource DiffRemovedBrush}" />
        </Style>

        <Style Selector="Button.paletteItem">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="Button.paletteItem.selected">
            <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
        </Style>

        <Style Selector="Button:focus, TextBox:focus, ComboBox:focus, TabItem:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>

        <Style Selector="Button.rail:focus">
            <Setter Property="Background" Value="{DynamicResource AccentMutedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>

        <Style Selector="TabItem.requestEditorTab">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
            <Setter Property="CornerRadius" Value="7,7,0,0" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style Selector="TabItem.requestEditorTab:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>

        <Style Selector="TabItem.requestEditorTab:selected">
            <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="TabItem.requestEditorTab:selected /template/ Border#PART_SelectedPipe">
            <Setter Property="IsVisible" Value="False" />
        </Style>
    </Application.Styles>
</Application>
